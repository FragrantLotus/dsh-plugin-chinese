{
  "name": "dsh-plugin-chinese",
  "version": "1.4.0",
  "type": "module",
  "description": "给每个已安装的 DSH 插件自动补上中文功能简介。插件名一律保持原样，只翻译简介，方便按名字找插件。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FragrantLotus/dsh-plugin-chinese.git"
  },
  "homepage": "https://github.com/FragrantLotus/dsh-plugin-chinese#readme",
  "bugs": {
    "url": "https://github.com/FragrantLotus/dsh-plugin-chinese/issues"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "inject.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/*.png",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "chinese",
    "i18n",
    "汉化",
    "中文"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "icon": "icon.svg"
}
